<View>
  <Header value="Проверка восстановления латиницы (медицинский текст)"/>
  <Style>
    .lsf-main-content { max-width: 100% !important; }
    .lsf-main-view__annotation { max-width: 100% !important; }
    .lsf-object { max-width: 100% !important; }
  </Style>

  <View style="padding:8px 12px; margin-bottom:6px; background: rgba(128,128,128,0.10); border-radius:6px;">
    <Text name="doc" value="Документ: $doc  •  стр. $page  •  тип: $entity_kind  •  критичность: $is_critical"/>
    <Text name="source_text" value="Исходный текст (native): $source_text"/>
    <Text name="resolved_text" value="Предложено системой: $resolved_text"/>
    <Text name="candidates" value="Кандидаты: $candidates"/>
    <Text name="why" value="Почему спорно: $why_uncertain  ($method, conf=$confidence)"/>
  </View>

  <Header value="Слово (≈600 DPI) — колёсиком мыши можно приблизить" size="4"/>
  <Image name="crop" value="$crop_word" zoom="true" zoomControl="true" width="100%"/>

  <Header value="Строка (контекст)" size="4"/>
  <Image name="crop_line" value="$crop_line" zoom="true" zoomControl="true" width="100%"/>

  <Header value="Страница (bbox подсвечен красным)" size="4"/>
  <Image name="crop_page" value="$crop_page" zoom="true" zoomControl="true" maxWidth="55%"/>

  <Header value="Решение" size="4"/>
  <Choices name="decision" toName="crop" choice="single" showInLine="false" required="true">
    <Choice value="accept" hint="Предложенная замена верна — принять"/>
    <Choice value="pick_candidate" hint="Верен ДРУГОЙ кандидат из списка"/>
    <Choice value="enter_own" hint="Ввести правильный вариант вручную (поле ниже)"/>
    <Choice value="source_ok" hint="Исходный текст верен — НЕ менять"/>
    <Choice value="illegible" hint="Неразборчиво даже по картинке"/>
    <Choice value="need_expert" hint="Нужен медицинский эксперт"/>
  </Choices>

  <Header value="Свой вариант / выбранный кандидат" size="5"/>
  <TextArea name="corrected_text" toName="crop" rows="1" maxSubmissions="1"
            placeholder="Правильная форма (если 'ввести свой' или 'выбрать кандидата')"/>

  <Header value="Тип сущности (если система ошиблась)" size="5"/>
  <Choices name="entity_kind_fix" toName="crop" choice="single" showInLine="true">
    <Choice value="icd"/><Choice value="atc"/><Choice value="tnm"/>
    <Choice value="gene"/><Choice value="drug"/><Choice value="dose"/>
    <Choice value="term"/><Choice value="not_entity"/>
  </Choices>
</View>
